# Скопіюйте у файл .env і за потреби змініть
DATABASE_URL=mysql+pymysql://food:food@localhost:3306/food_delivery?charset=utf8mb4
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=1

# Імітація роботи закладу та кур'єра (1 — увімкнено)
SIMULATION_ENABLED=1
SIM_STEP_SECONDS=20
SIM_DELIVERY_SECONDS=90
